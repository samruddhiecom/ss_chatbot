# Copy to .env and fill in. Only GROQ_API_KEY is required for live model calls.
GROQ_API_KEY=
SMART_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant
TEMPERATURE=0.2

# Embeddings (local, no key needed)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Conversation control
MAX_FOLLOWUPS_PER_STAGE=2
MAX_MESSAGES_PER_SESSION=60
GLOBAL_DAILY_CAP=2000
